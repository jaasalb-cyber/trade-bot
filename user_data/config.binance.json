{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": 20,
    "dry_run": true,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "timeframe": "1h",
    "strategy": "RaspiProStrategy",
    "strategy_path": "/freqtrade/user_data/strategies",
    "exchange": {
        "name": "binance",
        "key": "your_binance_api_key",
        "secret": "your_binance_secret_key",
        "ccxt_config": {
            "enableRateLimit": true
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "stoploss": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss_on_exchange": false
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0
    },
    "stoploss": -0.015,
    "trailing_stop": false,
    "minimal_roi": {
        "120": 0.0,
        "60": 0.015,
        "30": 0.03,
        "0": 0.05
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "unit": "minutes"
    },
    "use_exit_signal": true,
    "internals": {
        "process_throttle_secs": 5
    },
    "bot_name": "freqtrade-binance-futures"
}
