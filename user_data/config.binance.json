{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 4,
    "stake_currency": "USDT",
    "stake_amount": 40,
    "dry_run": true,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "timeframe": "1h",
    "strategy": "RaspiProStrategy",
    "strategy_path": "/freqtrade/user_data/strategies",
    "exchange": {
        "name": "binance",
        "key": "your_binance_api_key",
        "secret": "your_binance_secret_key",
        "ccxt_config": {
            "enableRateLimit": true
        },
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "LINK/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "order_types": {
        "entry": "market",
        "exit": "market",
        "stoploss": "market"
    },
    "stoploss": -0.025,
    "trailing_stop": true,
    "trailing_stop_positive": 0.012,
    "trailing_stop_positive_offset": 0.02,
    "trailing_only_offset_is_reached": true,
    "minimal_roi": {
        "120": 0.0,
        "60": 0.015,
        "30": 0.03,
        "0": 0.05
    },
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "unit": "minutes"
    },
    "use_exit_signal": true,
    "internals": {
        "process_throttle_secs": 5
    },
    "bot_name": "freqtrade-binance-futures"
}
